recreation -> re-kreation (to create again) ; rek-reation (relaxation)
bowed -> boed (bowed/bent) ; boughed (show respect, bend at the waist)
lead -> leed (guide, position, conductor) ; led (metal)
read -> reed (present tense) ; red (past tense)
wind -> wynd (wind, blow) ; wined (coil, conclude)
wound -> woond (trauma, lesion, laceration, stab, cut, injury) ; wow'nd (to traverse on a curving course, coil, coiled, turn)
live -> liv (alive, dwell) ; lyve (happening now)
object -> objekt (thing) ; ubject (verb)
close -> close (near) ; cloze (shut)
record -> rekkurd (document, achievement) ; rekord (to register, capture)
present -> prezent (show, give ) ; present (gift )
sow -> soh (plant) ; sow (pig)
row -> row (line, ordered) ; rau (argument)
bass -> base (low) ; bass (fish)
resume -> rezoom (restart, return to, reclaim) ; resume (CV, qualifications)
tear -> tair (rip, pull apart) ; teer (cry, tear-drop)
refuse -> refuze (deny) ; refuse (waste)
polish -> pole-ish (Nationality) ; pollish (shine)
invalid -> in-valid (not valid) ; invalid (disabled)
elaborate -> elaboreight (develop, evolve) ; elaborit (complex, intricate)
esitmate -> estimeight (verb t0 guess) ; estimit (noun the result of guessing)
